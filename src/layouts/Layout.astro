---
import { site, href } from '../site';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('rss.xml')} />
    <title>{title === site.title ? title : `${title} · ${site.title}`}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳至正文</a>
    <header class="header shell">
      <a class="brand" href={href()}><span class="brand-icon">思</span>{site.title}<span class="brand-sub">A DAILY JOURNAL</span></a>
      <nav aria-label="主导航"><a href={href()} aria-current={Astro.url.pathname === href() ? 'page' : undefined}>文章</a><a href={href('about/')}>关于</a><a href={href('rss.xml')}>RSS ↗</a></nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell footer"><span>© {new Date().getFullYear()} {site.title} · 认真生活，慢慢记录。</span><span>保持好奇，持续书写 ↗</span></footer>
  </body>
</html>
